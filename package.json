{
  "name": "after-effects-mcp",
  "version": "1.1.0",
  "description": "Adobe After Effects MCP server with automated dotLottie compilation, expression auto-baking, interactive state machines, and bidirectional ExtendScript bridge.",
  "author": "SUBSAHARXN",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SUBSAHARXN/after-effects-mcp.git"
  },
  "homepage": "https://github.com/SUBSAHARXN/after-effects-mcp#readme",
  "bugs": {
    "url": "https://github.com/SUBSAHARXN/after-effects-mcp/issues"
  },
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"src/scripts/**/*\" build",
    "start": "node build/index.js",
    "install-bridge": "node install-bridge.js",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "copyfiles": "^2.4.1",
    "typescript": "^5.2.2"
  }
}
